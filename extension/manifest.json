{
  "manifest_version": 3,
  "name": "Strat Buttons",
  "version": "1.2.0",
  "description": "PO3 Watch, Scriv Model, ICT Killzones and AMD Range Model on TradingView, TopstepX and Vest charts.",
  "action": { "default_popup": "popup.html", "default_title": "Strat Buttons" },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://www.tradingview.com/*",
    "https://*.tradingview.com/*",
    "https://*.topstepx.com/*",
    "https://topstepx.com/*",
    "https://trade.vestmarkets.com/*",
    "https://cdn.cboe.com/*",
    "https://cdn-api.cboe.com/*",
    "https://www.deribit.com/*"
  ]
}
