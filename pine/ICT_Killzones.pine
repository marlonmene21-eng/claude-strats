//@version=6
indicator("ICT Killzones", overlay = true, max_boxes_count = 300, max_lines_count = 300, max_labels_count = 300)

// Scanner: today's killzone boxes, session / prior-day liquidity (open or taken), 5m and 15m FVGs and rejection
// blocks (untapped in colour, tapped greyed), and recent CISDs. Everything since the 18:00 NY open.
showTapped = input.bool(true, "Show tapped zones (greyed)")
showTbl = input.bool(true, "Panel")
TZ = "America/New_York"
cBull = #26a69a
cBear = #ef5350
cDim = #787b86

// closed-candle FVG / RB detector for 5m and 15m
det() =>
    contiguous = (time[1] - time[3]) <= 2 * timeframe.in_seconds() * 1000
    fD = contiguous and low[1] > high[3] ? 1 : contiguous and high[1] < low[3] ? -1 : 0
    fT = fD == 1 ? low[1] : fD == -1 ? low[3] : na
    fB = fD == 1 ? high[3] : fD == -1 ? high[1] : na
    r3 = high[3] - low[3]
    isPL = low[3] < low[4] and low[3] < low[5] and low[3] <= low[2] and low[3] <= low[1]
    isPH = high[3] > high[4] and high[3] > high[5] and high[3] >= high[2] and high[3] >= high[1]
    rD = isPL and r3 > 0 and (math.min(open[3], close[3]) - low[3]) >= 0.3 * r3 ? 1 : isPH and r3 > 0 and (high[3] - math.max(open[3], close[3])) >= 0.3 * r3 ? -1 : 0
    rT = rD == 1 ? math.min(open[3], close[3]) : rD == -1 ? high[3] : na
    rB = rD == 1 ? low[3] : rD == -1 ? math.max(open[3], close[3]) : na
    [fD, fT, fB, time[3], rD, rT, rB, time[3], time[1], ta.atr(14)[1]]
[f5D, f5T, f5B, f5Tm, r5D, r5T, r5B, r5Tm, b5, a5] = request.security(syminfo.tickerid, "5", det(), lookahead = barmerge.lookahead_on)
[fFD, fFT, fFB, fFTm, rFD, rFT, rFB, rFTm, bF, aF] = request.security(syminfo.tickerid, "15", det(), lookahead = barmerge.lookahead_on)
[pdH, pdL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

type Zone
    float top
    float bot
    int   dir
    int   t
    string name
    int   tap = 0
    int   addBar
var array<Zone> zs = array.new<Zone>()

nyH = hour(time, TZ)
nyM = minute(time, TZ)
mins = nyH * 60 + nyM
newDay = nyH == 18 and nyM == 0 and not (hour(time[1], TZ) == 18 and minute(time[1], TZ) == 0)
var int dayStart = 0
if newDay
    zs.clear()
    dayStart := time

add(t, b, d, tm, nm) =>
    if not na(t) and not na(b) and t > b and tm >= dayStart
        zs.push(Zone.new(t, b, d, tm, nm, 0, bar_index))
if b5 != b5[1]
    if f5D != 0 and (f5T - f5B) >= 0.25 * a5
        add(f5T, f5B, f5D, f5Tm, "5m " + (f5D > 0 ? "Bullish" : "Bearish") + " FVG")
    if r5D != 0
        add(r5T, r5B, r5D, r5Tm, "5m " + (r5D > 0 ? "Bullish" : "Bearish") + " RB")
if bF != bF[1]
    if fFD != 0 and (fFT - fFB) >= 0.25 * aF
        add(fFT, fFB, fFD, fFTm, "15m " + (fFD > 0 ? "Bullish" : "Bearish") + " FVG")
    if rFD != 0
        add(rFT, rFB, rFD, rFTm, "15m " + (rFD > 0 ? "Bullish" : "Bearish") + " RB")
for z in zs
    if z.tap == 0 and bar_index > z.addBar and (z.dir > 0 ? low <= z.top : high >= z.bot)
        z.tap := time

// killzones + session liquidity
type Kz
    string name
    int    s
    int    e
    color  col
    float  h = na
    float  l = na
    int    hT = 0
    int    lT = 0
    int    t0 = 0
var array<Kz> kz = array.from(Kz.new("Asia", 1200, 1440, #9575cd), Kz.new("London", 120, 300, #4fc3f7), Kz.new("NY AM", 510, 660, #ffb74d), Kz.new("NY PM", 810, 960, #81c784))
for k in kz
    if newDay
        k.h := na, k.l := na, k.t0 := 0
    inK = mins >= k.s and mins < k.e
    if inK
        if k.t0 == 0
            k.t0 := time
        if na(k.h) or high > k.h
            k.h := high, k.hT := time
        if na(k.l) or low < k.l
            k.l := low, k.lT := time

// recent CISDs (chart timeframe)
var float dnRun = na
var float upRun = na
var array<float> cl = array.new<float>()
var array<int> cd = array.new<int>()
var array<int> ct = array.new<int>()
if close < open and not (close[1] < open[1])
    dnRun := open
if close > open and not (close[1] > open[1])
    upRun := open
if not na(dnRun) and close > dnRun and close[1] <= dnRun
    cl.push(dnRun), cd.push(1), ct.push(time), dnRun := na
if not na(upRun) and close < upRun and close[1] >= upRun
    cl.push(upRun), cd.push(-1), ct.push(time), upRun := na
while cl.size() > 4
    cl.shift(), cd.shift(), ct.shift()

var array<box> bx = array.new<box>()
var array<line> ln = array.new<line>()
var array<label> lb = array.new<label>()
takenAt(p, side, from) =>
    int res = 0
    for i = 0 to math.min(bar_index, 2000)
        if time[i] <= from
            break
        if side > 0 ? high[i] > p : low[i] < p
            res := time[i]
    res
if barstate.islast
    for b in bx
        b.delete()
    for l in ln
        l.delete()
    for l in lb
        l.delete()
    bx.clear(), ln.clear(), lb.clear()
    fut = time + 10 * timeframe.in_seconds() * 1000
    for k in kz
        if k.t0 != 0
            bx.push(box.new(k.t0, k.h, math.min(time, k.t0 + (k.e - k.s) * 60000), k.l, xloc = xloc.bar_time, border_color = k.col, bgcolor = color.new(k.col, 92), text = k.name + " Killzone", text_color = k.col, text_size = size.small, text_halign = text.align_left, text_valign = text.align_top))
            if time >= k.t0 + (k.e - k.s) * 60000
                for side in array.from(1, -1)
                    p = side > 0 ? k.h : k.l
                    tk = takenAt(p, side, k.t0 + (k.e - k.s) * 60000)
                    c = tk != 0 ? cDim : side > 0 ? #f5a623 : #42a5f5
                    ln.push(line.new(side > 0 ? k.hT : k.lT, p, tk != 0 ? tk : fut, p, xloc = xloc.bar_time, color = c, style = tk != 0 ? line.style_dashed : line.style_solid))
                    lb.push(label.new(tk != 0 ? tk : fut, p, k.name + (side > 0 ? " Buyside" : " Sellside") + " Liquidity" + (tk != 0 ? " (Taken)" : ""), xloc = xloc.bar_time, style = label.style_none, textcolor = c, size = size.small))
    for side in array.from(1, -1)
        p = side > 0 ? pdH : pdL
        if not na(p)
            tk = takenAt(p, side, dayStart)
            c = tk != 0 ? cDim : side > 0 ? #f5a623 : #42a5f5
            ln.push(line.new(dayStart, p, tk != 0 ? tk : fut, p, xloc = xloc.bar_time, color = c, style = tk != 0 ? line.style_dashed : line.style_solid))
            lb.push(label.new(tk != 0 ? tk : fut, p, (side > 0 ? "PDH Buyside" : "PDL Sellside") + " Liquidity" + (tk != 0 ? " (Taken)" : ""), xloc = xloc.bar_time, style = label.style_none, textcolor = c, size = size.small))
    for z in zs
        if z.tap == 0 or showTapped
            c = z.tap != 0 ? cDim : z.dir > 0 ? cBull : cBear
            bx.push(box.new(z.t, z.top, z.tap != 0 ? z.tap : fut, z.bot, xloc = xloc.bar_time, border_color = c, bgcolor = color.new(c, z.tap != 0 ? 93 : 84), text = z.name + (z.tap != 0 ? " (Tapped)" : ""), text_color = c, text_size = size.small, text_halign = text.align_left, text_valign = text.align_top))
    for [i, v] in cl
        c = cd.get(i) > 0 ? cBull : cBear
        ln.push(line.new(ct.get(i) - 5 * timeframe.in_seconds() * 1000, v, ct.get(i), v, xloc = xloc.bar_time, color = c, style = line.style_dashed))
        lb.push(label.new(ct.get(i), v, timeframe.period + " " + (cd.get(i) > 0 ? "Bullish" : "Bearish") + " CISD", xloc = xloc.bar_time, style = label.style_none, textcolor = c, size = size.small))

var table tb = table.new(position.top_right, 2, 4, bgcolor = color.new(#11151c, 5), border_width = 1, border_color = #262d3a)
if showTbl and barstate.islast
    string cur = "none"
    for k in kz
        if mins >= k.s and mins < k.e
            cur := k.name
    untapped = 0
    for z in zs
        untapped += z.tap == 0 ? 1 : 0
    table.cell(tb, 0, 0, "ICT Killzones", text_color = #42a5f5, text_size = size.normal, text_halign = text.align_left)
    table.cell(tb, 1, 0, "", text_size = size.small)
    table.cell(tb, 0, 1, "Killzone now", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 1, cur, text_color = cur == "none" ? color.gray : color.lime, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 2, "Untapped zones today", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 2, str.tostring(untapped) + " of " + str.tostring(zs.size()), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 3, "Last CISD", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 3, cl.size() > 0 ? (cd.last() > 0 ? "Bullish" : "Bearish") : "—", text_color = cl.size() > 0 ? (cd.last() > 0 ? cBull : cBear) : color.gray, text_size = size.small, text_halign = text.align_right)
